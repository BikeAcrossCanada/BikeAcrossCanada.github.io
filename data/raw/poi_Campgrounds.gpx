  <wpt lat="49.622161025181413" lon="-115.62523702159524">
    <ele>0</ele>
    <time>2026-08-24T14:43:26Z</time>
    <name>Fort Steele Resort &amp; RV Park</name>
    <cmt>description: "We offer over 60 tenting sites that are mostly located in a heavily treed area with water taps for everyone to share. Each site has a picnic table and some have their own fire pit. Because of the heavy trees not every site has its own fire pit, but we do have community fire pits for everyone's enjoyment as well as a covered shelter to share and available portable fire pits for rent.&lt;br&gt;&lt;br&gt;All sites have access to the outdoor solar heated swimming pool, playground, sports field and basketball hoop. There are free hot showers for registered guests only and a coin operated Laundromat with single and triple front load washing machines. See all the amenities and activities the resort has to offer."&lt;br&gt;https://www.fortsteele.com/tent-sites&lt;br&gt;Type: Privately Owned Campground&lt;br&gt;ID:</cmt>
    <desc>description: "We offer over 60 tenting sites that are mostly located in a heavily treed area with water taps for everyone to share. Each site has a picnic table and some have their own fire pit. Because of the heavy trees not every site has its own fire pit, but we do have community fire pits for everyone's enjoyment as well as a covered shelter to share and available portable fire pits for rent.&lt;br&gt;&lt;br&gt;All sites have access to the outdoor solar heated swimming pool, playground, sports field and basketball hoop. There are free hot showers for registered guests only and a coin operated Laundromat with single and triple front load washing machines. See all the amenities and activities the resort has to offer."&lt;br&gt;https://www.fortsteele.com/tent-sites&lt;br&gt;Type: Privately Owned Campground&lt;br&gt;ID:</desc>
    <sym>Campground</sym>
    <type>user</type>
    <extensions>
      <gpxx:WaypointExtension>
        <gpxx:DisplayMode>SymbolAndName</gpxx:DisplayMode>
      </gpxx:WaypointExtension>
      <wptx1:WaypointExtension>
        <wptx1:DisplayMode>SymbolAndName</wptx1:DisplayMode>
      </wptx1:WaypointExtension>
      <ctx:CreationTimeExtension>
